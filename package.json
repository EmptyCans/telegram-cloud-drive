{
  "name": "telegram-cloud-drive",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:preview": "esbuild src/document-renderers.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=public/document-renderers.js",
    "check": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "wrangler": "^4.45.0"
  }
}
